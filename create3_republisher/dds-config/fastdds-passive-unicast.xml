<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <!-- Custom UDPv4 transport with increased initial peers range for more nodes on localhost -->
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>custom_transport</transport_id>
                <type>UDPv4</type>
                <maxInitialPeersRange>120</maxInitialPeersRange>  <!-- Increased to support up to ~120 nodes -->
            </transport_descriptor>
        </transport_descriptors>

        <!-- Participant profile for active unicast (e.g., for Raspberry Pi or host side) -->
        <participant profile_name="active_unicast_profile" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>custom_transport</transport_id>
                </userTransports>
                <!-- Example unicast metatraffic locators (replace ROBOT_IP with actual IP if not localhost) -->
                <builtin>
                    <metatrafficUnicastLocatorList>
                        <locator/>
                    </metatrafficUnicastLocatorList>
                    <initialPeersList>
                        <locator>
                            <udpv4>
                                <address>127.0.0.1</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>